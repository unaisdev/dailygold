# Everything below is recreated by the scripts in scripts/ (see README).

# Toolchain created by setup-macos.sh / setup-linux.sh
/.toolchain/

# Generated ROMs (including the browser's gzip copy); never commit these.
/pokefirered/*.gba
/pokefirered/*.elf
/pokefirered/*.map
/pokefirered/*.sym
/web/game/*.gba
/web/game/*.gba.gz

# Wrangler's local cache (Cloudflare deploys)
/.wrangler/

/tests/node_modules/
/tests/output/
.DS_Store
.gh-config

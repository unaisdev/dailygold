+    if (gTrainerBattleOpponent_A != TRAINER_DAILYRED_RED
+     || gBattleMons[gBattlerAttacker].species != SPECIES_GYARADOS)
+        return;
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        u16 move = gBattleMons[gBattlerAttacker].moves[i];
+
+        moveDamage[i] = -1;
+        if (move == MOVE_NONE || AI_THINKING_STRUCT->score[i] == 0
+         || gBattleMons[gBattlerAttacker].pp[i] == 0
+         || gBattleMoves[move].power <= 1)
+            continue;
+
+        gDynamicBasePower = 0;
+        gBattleStruct->dynamicMoveType = 0;
+        gBattleScripting.dmgMultiplier = 1;
+        gMoveResultFlags = 0;
+        gCritMultiplier = 1;
+        gCurrentMove = move;
+        AI_CalcDmg(gBattlerAttacker, gBattlerTarget);
+        TypeCalc(gCurrentMove, gBattlerAttacker, gBattlerTarget);
+        moveDamage[i] = gBattleMoveDamage * AI_THINKING_STRUCT->simulatedRNG[i] / 100;
+        if (moveDamage[i] == 0)
+            moveDamage[i] = 1;
+
+        if (moveDamage[i] > bestDamage)
+            bestDamage = moveDamage[i];
+    }
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (moveDamage[i] == bestDamage && AI_THINKING_STRUCT->score[i] > bestDamageScore)
+            bestDamageScore = AI_THINKING_STRUCT->score[i];
+    }
+
+    if (bestDamageScore == 0)
+        return;
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (moveDamage[i] >= 0 && moveDamage[i] < bestDamage
+         && AI_THINKING_STRUCT->score[i] >= bestDamageScore)
+            AI_THINKING_STRUCT->score[i] = bestDamageScore - 1;
+    }
+}

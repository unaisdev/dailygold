+
+// EVs for each Pokemon above, in the same order.
+// Stat order: HP, Attack, Defense, Speed, Sp. Atk, Sp. Def (max 255 each, 510 total).
+// Vanilla FireRed trainers have no EVs; DailyRed_ApplyBossEVs adds these.
+const u8 gDailyRedBossEVs[DAILYRED_BOSS_PARTY_SIZE][NUM_STATS] =

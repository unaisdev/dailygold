+    {  4, 252,   0, 252,   0,   0}, // Gyarados
+    {252,   0,   0,   0, 252,   6}, // Ampharos
+    {  4, 252,   0, 252,   0,   0}, // Heracross
+    {252,   0, 252,   0,   0,   4}, // Umbreon
+    {252, 252,   0,   6,   0,   0}, // Ho-Oh
+    {  4,   0,   0, 252, 252,   0}, // Typhlosion
+};
+
+// Trainer personalities are fixed by the existing deterministic trainer
+// party generator. These values set the requested nature without consuming
+// RNG or changing the player's Daily Gold team generation.

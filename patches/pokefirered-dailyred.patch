diff --git a/data/maps/DailyRed_Summit/scripts.inc b/data/maps/DailyRed_Summit/scripts.inc
new file mode 100644
index 0000000..033ded0
--- /dev/null
+++ b/data/maps/DailyRed_Summit/scripts.inc
@@ -0,0 +1,77 @@
+DailyRed_Summit_MapScripts::
+	.byte 0
+
+@ Talking to RED starts the battle. TRAINER_BATTLE_EARLY_RIVAL with
+@ RIVAL_BATTLE_HEAL_AFTER lets the player lose without whiting out, and sets
+@ VAR_RESULT to TRUE if they lost. The DailyRed_On* specials tell the website
+@ how the battle is going (see src/dailyred.c).
+DailyRed_Summit_EventScript_Red::
+	lock
+	faceplayer
+	textcolor NPC_TEXT_COLOR_MALE
+	msgbox DailyRed_Summit_Text_RedIntro
+	special DailyRed_OnBattleStart
+	trainerbattle_earlyrival TRAINER_DAILYRED_RED, RIVAL_BATTLE_HEAL_AFTER, DailyRed_Summit_Text_RedDefeat, DailyRed_Summit_Text_RedVictory
+	special DailyRed_OnBattleEnd
+	addvar VAR_DAILYRED_BATTLES, 1
+	textcolor NPC_TEXT_COLOR_NEUTRAL
+	goto_if_eq VAR_RESULT, TRUE, DailyRed_Summit_EventScript_PlayerLost
+	addvar VAR_DAILYRED_WINS, 1
+	playfanfare MUS_OBTAIN_BADGE
+	message DailyRed_Summit_Text_PlayerWon
+	waitmessage
+	waitfanfare
+	waitbuttonpress
+	call DailyRed_Summit_EventScript_BufferRecord
+	specialvar VAR_RESULT, DailyRed_IsDailyGame
+	goto_if_eq VAR_RESULT, TRUE, DailyRed_Summit_EventScript_DailyWin
+	goto DailyRed_Summit_EventScript_NextRun
+	end
+
+DailyRed_Summit_EventScript_PlayerLost::
+	msgbox DailyRed_Summit_Text_PlayerLost
+	call DailyRed_Summit_EventScript_BufferRecord
+	specialvar VAR_RESULT, DailyRed_IsDailyGame
+	goto_if_eq VAR_RESULT, TRUE, DailyRed_Summit_EventScript_DailyLoss
+	goto DailyRed_Summit_EventScript_NextRun
+	end
+
+DailyRed_Summit_EventScript_BufferRecord::
+	buffernumberstring STR_VAR_1, VAR_DAILYRED_WINS
+	buffernumberstring STR_VAR_2, VAR_DAILYRED_BATTLES
+	return
+
+@ The website's daily game: one battle a day. After the record the screen
+@ fades out and the website closes the game.
+DailyRed_Summit_EventScript_DailyWin::
+	msgbox DailyRed_Summit_Text_RecordWin
+	goto DailyRed_Summit_EventScript_DailyGameOver
+	end
+
+DailyRed_Summit_EventScript_DailyLoss::
+	msgbox DailyRed_Summit_Text_RecordLoss
+	goto DailyRed_Summit_EventScript_DailyGameOver
+	end
+
+DailyRed_Summit_EventScript_DailyGameOver::
+	closemessage
+	fadescreen FADE_TO_BLACK
+	special DailyRed_OnDailyGameOver
+	@ Keep the script running so the player can't move or talk to RED again
+	@ before the website closes the game.
+DailyRed_Summit_EventScript_DailyGameOverHold::
+	delay 60
+	goto DailyRed_Summit_EventScript_DailyGameOverHold
+	end
+
+@ Anywhere else (practice runs, desktop emulators): straight into a new run.
+DailyRed_Summit_EventScript_NextRun::
+	msgbox DailyRed_Summit_Text_NextRun
+	closemessage
+	fadescreen FADE_TO_BLACK
+	special DailyRed_StartNextRun
+	@ Re-entering the map puts the player back at the start and resets RED.
+	warpsilent MAP_DAILY_RED_SUMMIT, DAILYRED_START_X, DAILYRED_START_Y
+	waitstate
+	release
+	end
diff --git a/data/maps/DailyRed_Summit/text.inc b/data/maps/DailyRed_Summit/text.inc

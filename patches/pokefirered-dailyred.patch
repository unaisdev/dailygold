+++ b/data/maps/DailyRed_Summit/text.inc
@@ -0,0 +1,38 @@
+DailyRed_Summit_Text_RedIntro::
+    .string "Te estaba esperando HORTELANO.\p"
+    .string "Así que finalmente has podido\n"
+    .string "derrotar a RED.\p"
+    .string "Pero bueno, siento decirte que\n"
+    .string "hasta aquí has llegado.\p"
+    .string "Te voy a derrotar igual que le\n"
+    .string "derroté a él en su momento.$"
+
+@ Shown in battle when Gold loses.
+DailyRed_Summit_Text_RedDefeat::
+    .string "¡Has derrotado a GOLD de la\n"
+    .string "ELITE FOUR de CAMPEONES!$"
+
+@ Shown in battle when Gold wins.
+DailyRed_Summit_Text_RedVictory::
+    .string "...$"
+
+DailyRed_Summit_Text_PlayerWon::
+    .string "¡Has derrotado a ELITE FOUR GOLD!$"
+
+DailyRed_Summit_Text_PlayerLost::
+    .string "¡Han derrotado a todo tu equipo!$"
+
+DailyRed_Summit_Text_RecordWin::
+    .string "Récord\pVictorias: {STR_VAR_1}\n"
+    .string "Combates: {STR_VAR_2}.\p"
+    .string "¡Vuelve mañana!$"
+
+DailyRed_Summit_Text_RecordLoss::
+    .string "Récord\pVictorias: {STR_VAR_1}\n"
+    .string "Combates: {STR_VAR_2}.\p"
+    .string "¡Inténtalo mañana!$"
+
+DailyRed_Summit_Text_NextRun::
+    .string "Récord\pVictorias: {STR_VAR_1}\n"
+    .string "Combates: {STR_VAR_2}.\pNuevo equipo listo.\n"
+    .string "¡Sube y enfréntate a GOLD!$"
